<br>
<span><span class="darkmode-ignore">🔖</span><i>categories</i></span>
<ul class="" >


  <% var array = site.posts.data.slice() %>

  <% var categoriesHashMap = new Map() %>
  <% var categoryChildHashmap = new Map() %>
  <% var childCountMap = new Map() %>
  <% var categoriesList = [] %>
  
  <% for(var i = 0; i < array.length; i++) {
     if(!('hide' in array[i]) || array[i].hide == false){

        var postCategories = array[i].categories.data;
        for(var j = 0; j < postCategories.length; j++) {

          if(postCategories.length > 1) {
            var childCat = postCategories[1];
            var parentName = postCategories[0].name;
            // 记录父分类下的子分类（去重），用于二级分类展示
            if(!categoryChildHashmap.has(parentName)) {
              categoryChildHashmap.set(parentName, []);
            }
            var childListOfParent = categoryChildHashmap.get(parentName);
            var childExists = false;
            for(var k = 0; k < childListOfParent.length; k++) {
              if(childListOfParent[k].name == childCat.name) { childExists = true; break; }
            }
            if(!childExists) { childListOfParent.push(childCat); }
            // 子分类文章计数
            if(!childCountMap.has(childCat.name)) {
              childCountMap.set(childCat.name, 1);
            } else {
              childCountMap.set(childCat.name, childCountMap.get(childCat.name) + 1);
            }
          }

          if(!categoriesHashMap.has(postCategories[j].name)) {
            categoriesHashMap.set(postCategories[j].name, 1);
            categoriesList.push(postCategories[j].name);
          } else {
            categoriesHashMap.set(postCategories[j].name, categoriesHashMap.get(postCategories[j].name) + 1);
          }
        }
     }
  }  %>
      <% for (let i = 0; i < categoriesList.length; i++) { %>
        <% var catName = categoriesList[i] %>
        <li class="">
            <a href="/categories<%- url_for(catName) %>"><%= catName %></a>
            <span><i><%= categoriesHashMap.get(catName) %></i></span>
        </li>
        <% if(categoryChildHashmap.has(catName)) { %>
          <% var childListOfParent = categoryChildHashmap.get(catName) %>
          <% for (let k = 0; k < childListOfParent.length; k++) { %>
            <% var childCat = childListOfParent[k] %>
            <li class="category-child">
                <a href="<%- url_for(childCat.path) %>"><%= childCat.name %></a>
                <span><i><%= childCountMap.has(childCat.name) ? childCountMap.get(childCat.name) : 0 %></i></span>
            </li>
          <% } %>
        <% } %>
    <% } %>
    

    
</ul>