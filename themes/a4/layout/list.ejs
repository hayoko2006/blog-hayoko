<div class="archive-list">
  <ul class="archive">
      <% var isPaged = !!(theme.index.pagination && page.posts && (path == "index.html" || /^page\/\d+\/index\.html$/.test(path))) %>
      <% var postArray = isPaged ? page.posts.data : site.posts.data.slice() %>

      <!--文章先按照时间排好序-->
      <% postArray.sort((a, b) => {
          if (a.date > b.date) {
            return -1;
          }
          if (a.date < b.date) {
            return 1;
          }
          return 0;
        }) 
      %>


      


      <% const hashmap = new Map() %>
      <% const allYearList = [] %>
      <% var topPostArray = [] %>

      <!--循环遍历文章数组-->
      <% for (let i = 0; i < postArray.length; i++) { 
        if(!('hide' in postArray[i]) || postArray[i].hide == false) {
          if('top' in postArray[i]) {
            topPostArray.push(postArray[i]);
          } else {
            var postYear = new Date(postArray[i].date).getFullYear();
            if(!hashmap.has(postYear)) {
              hashmap.set(postYear, []);
              allYearList.push(postYear);
            } 
            hashmap.get(postYear).push(postArray[i]);
          }
        }
      }  %>

      <!--排序 置顶 文章-->
      <% 
        topPostArray.sort((a, b) => {
          return a.top - b.top;
        }) 
      %>

      <!--先放 置顶 文章-->
      <% for (let i = 0; i < topPostArray.length; i++) { %>
          <% var thisPost = topPostArray[i] %>
          <li>
            <span class="archive-date"> &nbsp;&nbsp;&nbsp;TOP
            </span>
            <div class="archive-main">
                <a class="archive-title" href="<%- url_for(thisPost.path) %>"><%= thisPost.title %></a>
            </div>
          </li>
      <% } %>

      <!--rough-notation风格效果-->
      <% if(theme && theme.listInfo.enable) { %>
        <script src="<%= url_for('/js/roughNotation.js') %>" defer></script>
        <script>
          // 浏览器严格模式
          if (typeof window !== 'undefined') {
            window.themeConfig = <%- JSON.stringify(theme) %>;
          }
          document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.archive-title').forEach(el => {
              const annotation = RoughNotation.annotate(el, {
                type: themeConfig?.tool?.hoverStyle || 'underline', // 效果,默认为'underline'
                color: themeConfig?.tool?.hoverColor || '#4f7dde', // 自定义效果颜色
                animationDuration: themeConfig?.tool?.animationDuration || 800, // 动画持续时间ms
              });
              el.addEventListener('mouseenter', () => {
                if(annotation){
                annotation.show();
            }});
              el.addEventListener('mouseleave', () => {
                if(annotation){
                annotation.hide();
            }});
            });
          });
        </script>
        <% } %>

      <!--文章先按照时间排好序-->
      <% postArray.sort((a, b) => {
        if (a.updated > b.updated) {
          return -1;
        }
        if (a.updated < b.updated) {
          return 1;
        }
        return 0;
      }) 
    %>
      
      <!--再放 最近更新 文章-->
      <% if(theme.tool.recentUpdatePost) { %>
        <li>
          <span class="year-font-color">
            <a class="archive-title"  href="/recent-updates/">Recent-Updates</a>
          </span>
        </li>
        <% var countRecentPost = 0 %>
        <% for (let i = 0; i < postArray.length && countRecentPost < 3; i++) { %>
          <% if(('hide' in postArray[i]) && postArray[i].hide == true) { continue; } else { countRecentPost++;}%>
          <% var thisPost = postArray[i] %>
          <li>
            <span class="archive-date"><%= date(thisPost.updated, "YYYY/MM/DD") %> 
            </span>
            <div class="archive-main">
                <a class="archive-title" href="<%- url_for(thisPost.path) %>"><%= thisPost.title %></a>
            </div>
          </li>
        <% } %>
      <% } %>

      <!--后放 其他 文章-->
      <% var collapseYear = theme.listInfo.collapseYear > 0 ? theme.listInfo.collapseYear : 0 %>
      <% for (let i = 0; i < allYearList.length; i++) { %>
        <% var year = allYearList[i] %>
        <% var yearHidden = collapseYear > 0 && i >= collapseYear %>
        <li <% if(collapseYear > 0) { %>class="year-toggle" data-year="<%= year %>" style="cursor: pointer;"<% } %>>
          <span class="year-font-color"><%= year %>[<%= hashmap.get(year).length %>]
            <% if(collapseYear > 0) { %><span class="year-arrow"><%= yearHidden ? '▸' : '▾' %></span><% } %>
            <% if(i==0) { %> <span class="darkmode-ignore">🍃</span> <% } %>
          </span>
        </li>
        <% var thisYearPostList = hashmap.get(year) %>
        <% for(var j = 0; j < thisYearPostList.length; j++) { %>
          <% var thisPost = thisYearPostList[j] %>
          <li class="year-posts<%= yearHidden ? ' hidden-year' : '' %>" data-year="<%= year %>">
            <span class="archive-date">&nbsp;&nbsp;&nbsp;<%= date(thisPost.date, "MM/DD") %> 
            </span>
            <div class="archive-main">
              <% if(!theme.listInfo.hideCategory && thisPost.categories.length > 0) { %>
                <a class="archive-title"  href="/<%= thisPost.categories.data[0].path %>">
                  <%= thisPost.categories.data[0].name %> 
                </a> | 
              <% } %>
                <a class="archive-title" href="<%- url_for(thisPost.path) %>"><%= thisPost.title %></a>
            </div>
          </li>
        <% } %>
      <% } %>
  </ul>
</div>
<% if(isPaged) { %>
    <%- partial('_partial/paginator') %>
<% } %>
<% if(collapseYear > 0) { %>
<script>
  // 年份折叠：点击年份展开/收起该年份下的文章
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.archive .year-toggle').forEach(head => {
      head.addEventListener('click', () => {
        const year = head.getAttribute('data-year');
        const posts = document.querySelectorAll('.archive .year-posts[data-year="' + year + '"]');
        if (!posts.length) return;
        const willShow = posts[0].classList.contains('hidden-year');
        posts.forEach(li => li.classList.toggle('hidden-year', !willShow));
        const arrow = head.querySelector('.year-arrow');
        if (arrow) arrow.textContent = willShow ? '▾' : '▸';
      });
    });
  });
</script>
<% } %>